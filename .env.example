# Local docker compose stack. Copy to .env and adjust ports if they clash.
#   cp .env.example .env
# These are LOCAL DEVELOPMENT placeholders only - never real credentials.
# Staging and production read every value from AWS Secrets Manager instead.

POSTGRES_USER=clinicai
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_DB=clinicai
# Change this if you already run PostgreSQL on 5432.
POSTGRES_PORT=5432

# S3-compatible local storage (SeaweedFS). The recordings bucket is private: these
# credentials are the only identity that can read or write it.
S3_PORT=4566
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local_dev_only_change_me
RECORDINGS_BUCKET=clinicai-recordings-local
