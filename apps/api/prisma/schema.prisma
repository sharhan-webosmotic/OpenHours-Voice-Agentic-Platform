// ClinicAI schema. Conventions, applied to every model:
//  - UUID v7 primary keys generated in the application (uuidV7()), never by the database,
//    so an id exists before the row is written and sorts by creation time.
//  - snake_case in PostgreSQL via @map / @@map; camelCase in TypeScript.
//  - timestamptz for every instant (@db.Timestamptz). UTC is stored and transmitted.
//  - organisation_id on every tenant table, and every composite index starts with it,
//    because every tenant query filters on it first.
//
// Tenant-less tables and why (M1-04 requires this list):
//  - organisations: it IS the tenant. Its primary key is the tenant id. A row-level
//    security policy is still applied to it in M1-06, keyed on id rather than
//    organisation_id, so a clinic cannot read another clinic's organisation row.
//  - users: organisation_id is NULL for the two platform roles and required for clinic
//    roles (CHECK constraint in M1-06). Platform rows are reachable only with
//    app.platform = 'on'.
//  - refresh_tokens: keyed to a user, which may be a platform user with no organisation.
//    Only the login and refresh paths touch it, always through asSystem, never inside a
//    tenant-scoped query. Holds no patient data.
//  - audit_logs: organisation_id is nullable because platform actions have no
//    organisation. Nullable rows are visible only with app.platform = 'on'.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  INTERNAL_ADMIN
  CLINIC_OWNER
  CLINIC_MANAGER
  DOCTOR
  STAFF

  @@map("role")
}

enum UserStatus {
  ACTIVE
  INVITED
  DEACTIVATED

  @@map("user_status")
}

enum OrganisationStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@map("organisation_status")
}

enum Provider {
  SARVAM

  @@map("provider")
}

enum PhoneKind {
  CLINIC_LINE
  AGENT_NUMBER

  @@map("phone_kind")
}

enum NotificationChannel {
  IN_APP
  EMAIL

  @@map("notification_channel")
}

model Organisation {
  id                      String             @id @db.Uuid
  name                    String
  /// IANA zone, e.g. Asia/Kolkata. Clinic-local times are derived from this at the edges.
  timezone                String
  status                  OrganisationStatus @default(ACTIVE)
  /// Clinic-level toggles, e.g. recordings_visible_to_staff. Never patient data.
  settings                Json               @default("{}")
  recordingRetentionDays  Int                @default(90) @map("recording_retention_days")
  /// When the full week of opening hours was last saved.
  ///
  /// The distinction this exists for: a weekday with no `clinic_hours` rows is a weekly
  /// off, which is a real answer, and a clinic whose hours have never been collected also
  /// has no rows. From row counts alone the two are identical, and the voice agent would
  /// have to guess which. Saving hours always writes all seven weekdays and sets this, so
  /// NULL means the question has not been asked.
  openingHoursCollectedAt DateTime?          @map("opening_hours_collected_at") @db.Timestamptz(6)
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  users               User[]
  phoneNumbers        PhoneNumber[]
  voiceAgents         VoiceAgent[]
  devices             Device[]
  pairingCodes        PairingCode[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  clinicHours         ClinicHours[]
  doctors             Doctor[]
  doctorWorkingHours  DoctorWorkingHours[]
  doctorTimeOff       DoctorTimeOff[]
  services            Service[]
  doctorServices      DoctorService[]
  patients            Patient[]
  appointments        Appointment[]
  calls               Call[]
  callTranscriptTurns CallTranscriptTurn[]
  prescriptions       Prescription[]
  prescriptionItems   PrescriptionItem[]
  followUps           FollowUp[]
  outboundCalls       OutboundCall[]
  forwardingSchedules ForwardingSchedule[]
  forwardingEvents    ForwardingEvent[]
  webhookEvents       WebhookEvent[]
  supportSessions     SupportSession[]

  clinicProfile       ClinicProfile?
  clinicBookingPolicy ClinicBookingPolicy?
  clinicAgentProfile  ClinicAgentProfile?
  clinicTelephony     ClinicTelephony?
  clinicFaqs          ClinicFaq[]

  @@index([status])
  @@map("organisations")
}

model User {
  id                 String     @id @db.Uuid
  /// NULL for SUPER_ADMIN and INTERNAL_ADMIN; required for clinic roles (CHECK in M1-06).
  organisationId     String?    @map("organisation_id") @db.Uuid
  /// citext, so uniqueness and lookup are case-insensitive without lowering at call sites.
  email              String     @unique @db.Citext
  passwordHash       String     @map("password_hash")
  fullName           String     @map("full_name")
  role               Role
  status             UserStatus @default(ACTIVE)
  /// Set when an administrator issues a temporary password.
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  /// Lockout expiry. NULL means not locked.
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz(6)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation      Organisation?    @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  refreshTokens     RefreshToken[]
  pairingCodes      PairingCode[]
  notifications     Notification[]
  doctorProfile     Doctor?
  assignedFollowUps FollowUp[]
  supportSessions   SupportSession[]

  @@index([organisationId, status])
  @@index([organisationId, role])
  @@map("users")
}

model RefreshToken {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// SHA-256 of the opaque token. The token itself is never stored.
  tokenHash String    @unique @map("token_hash")
  /// Rotation lineage. Presenting a revoked token revokes the whole family.
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PhoneNumber {
  id             String    @id @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  /// E.164. Globally unique for AGENT_NUMBER (partial unique index in M1-06), because an
  /// inbound call is resolved to an organisation by the number dialled.
  e164           String
  kind           PhoneKind
  label          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  voiceAgents  VoiceAgent[]

  @@unique([organisationId, e164])
  @@index([organisationId, kind])
  @@map("phone_numbers")
}

/// The provider-side mapping for one clinic's agent, entered BY HAND after the Sarvam
/// setup has been done in Sarvam's own console. Nothing here is provisioned automatically.
///
/// WHY THESE ARE TYPED COLUMNS AND NOT `config` JSON. Every one of them is resolved on a
/// request path: an inbound call is matched to an organisation, and a tool call is
/// authenticated against this clinic's secret. A Json blob would put that lookup behind a
/// shape nothing validates, and a typo in a key would read as an absent value rather than
/// as an error. `config` stays for genuinely provider-shaped extras.
///
/// `sarvamAppId` WAS `externalAgentId`. The two named the same thing, and holding both
/// would have left two columns to keep in step with nothing enforcing it, so the generic
/// name was dropped rather than kept beside the specific one. It is nullable because the
/// row exists from the moment a clinic is created and the id does not arrive until someone
/// has finished the manual setup.
model VoiceAgent {
  id                 String             @id @db.Uuid
  organisationId     String             @map("organisation_id") @db.Uuid
  provider           Provider           @default(SARVAM)
  /// Sarvam's application identifier. Resolves a webhook to an organisation.
  sarvamAppId        String?            @map("sarvam_app_id")
  sarvamAppVersion   String?            @map("sarvam_app_version")
  sarvamDeploymentId String?            @map("sarvam_deployment_id")
  sarvamConnectionId String?            @map("sarvam_connection_id")
  /// The number patients dial. Bought inside Sarvam (D-005), platform-unique.
  agentNumberId      String?            @map("agent_number_id") @db.Uuid
  /// SHA-256 of the per-clinic tool secret (D-004). The secret itself is shown once at
  /// generation and is never stored, never logged and never returned by any endpoint.
  toolSecretHash     String?            @map("tool_secret_hash")
  toolSecretSetAt    DateTime?          @map("tool_secret_set_at") @db.Timestamptz(6)
  /// SHA-256 of the secret that appears in this clinic's webhook URL path (D-006).
  ///
  /// SEPARATE FROM THE TOOL SECRET ON PURPOSE. This one travels in a URL, where proxies,
  /// access logs and browser history can see it, so it must not also be the credential the
  /// tool endpoints accept in a header. Same storage rule as the tool secret: minted by the
  /// platform, shown once, stored only as a hash, never returned by any endpoint.
  webhookSecretHash  String?            @map("webhook_secret_hash")
  webhookSecretSetAt DateTime?          @map("webhook_secret_set_at") @db.Timestamptz(6)
  /// Which master prompt version is loaded into the Sarvam agent right now, so a prompt
  /// change in this repository can be compared with what the agent is actually running.
  promptVersion      String?            @map("prompt_version")
  /// Provider-specific extras, validated by a zod schema before write.
  config             Json               @default("{}")
  status             OrganisationStatus @default(ACTIVE)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  agentNumber  PhoneNumber? @relation(fields: [agentNumberId], references: [id], onDelete: SetNull)

  /// One agent row per clinic per provider, which is D-004 expressed as a constraint
  /// rather than as a convention. It is also what makes the create idempotent enough that
  /// a double-submitted "create clinic" cannot leave two agent shells behind.
  @@unique([organisationId, provider])
  @@unique([provider, sarvamAppId])
  /// The tool secret is what every voice tool call presents, so resolving it to a clinic is
  /// an index probe rather than a scan of one row per clinic, which is what it was before.
  /// UNIQUE as well as indexed, because two clinics sharing a secret would mean either
  /// clinic's agent could act on the other's patients, and nothing else would notice.
  /// PostgreSQL allows many NULLs in a unique index, so clinics with no secret yet are fine.
  @@unique([toolSecretHash])
  /// Resolves an incoming webhook to a clinic by the secret in its URL, as an index probe.
  /// Unique for the same reason the tool secret is: two clinics sharing it would mean either
  /// clinic's calls could be attributed to the other.
  @@unique([webhookSecretHash])
  /// The webhook payload names a deployment, and the clinic is resolved from OUR table by
  /// that id rather than from anything the payload asserts about itself.
  @@index([provider, sarvamDeploymentId])
  @@index([organisationId, status])
  @@map("voice_agents")
}

model Device {
  id             String    @id @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  label          String
  /// SHA-256 of the device token. Scoped to forwarding endpoints only.
  tokenHash      String    @unique @map("token_hash")
  lastSeenAt     DateTime? @map("last_seen_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, revokedAt])
  @@map("devices")
}

model PairingCode {
  id              String    @id @db.Uuid
  organisationId  String    @map("organisation_id") @db.Uuid
  /// SHA-256 of the 6-character code. Single use, 10-minute lifetime.
  codeHash        String    @unique @map("code_hash")
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt      DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation  Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdByUser User         @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([organisationId, expiresAt])
  @@map("pairing_codes")
}

model Notification {
  id             String              @id @db.Uuid
  organisationId String              @map("organisation_id") @db.Uuid
  /// NULL addresses every user in the organisation.
  userId         String?             @map("user_id") @db.Uuid
  channel        NotificationChannel @default(IN_APP)
  /// Message template key plus id-only parameters. Never patient field values.
  kind           String
  payload        Json                @default("{}")
  readAt         DateTime?           @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organisationId, userId, readAt])
  @@index([organisationId, createdAt])
  @@map("notifications")
}

model AuditLog {
  id             String   @id @db.Uuid
  /// NULL for platform-level actions that belong to no organisation.
  organisationId String?  @map("organisation_id") @db.Uuid
  /// NULL when the actor is the system (a job, or a provider webhook).
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  actorRole      Role?    @map("actor_role")
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id") @db.Uuid
  /// IDs and changed field NAMES only, never patient field values.
  metadata       Json     @default("{}")
  ipAddress      String?  @map("ip_address") @db.Inet
  userAgent      String?  @map("user_agent")
  requestId      String?  @map("request_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
  @@index([organisationId, actorUserId, createdAt])
  @@index([organisationId, entityType, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ─── Clinic domain (M1-05) ───────────────────────────────────────────────────────
// Same conventions as M1-04: UUID v7 keys from the application, snake_case mapping,
// timestamptz, organisation_id on every table with every composite index led by it.
//
// webhook_events is the one new table with a NULLABLE organisation_id: a provider
// payload is stored BEFORE it is understood (root CLAUDE.md rule 8), so the
// organisation is not known at insert time. Unresolved rows are reachable only with
// app.platform = 'on', which is what an operator debugging a failed webhook needs.

/// How the agent should sound. Stored as an enum rather than free text because the
/// rendered prompt branches on it, and "warm but professional-ish" is not a branch.
enum AgentTone {
  FORMAL
  FRIENDLY
  NEUTRAL

  @@map("agent_tone")
}

/// How recording consent is obtained.
///
/// `NOT_RECORDED` is the only mode needing no consent, because nothing is kept. The other
/// two require the announcement text to exist, which the shared schema enforces. Honouring
/// the mode is the agent's and the recording pipeline's job, both of which arrive with the
/// voice work; this records the clinic's decision.
enum RecordingConsentMode {
  NOT_RECORDED
  ANNOUNCEMENT
  EXPLICIT_OPT_IN

  @@map("recording_consent_mode")
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY

  @@map("weekday")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW

  @@map("appointment_status")
}

enum AppointmentSource {
  VOICE_AGENT
  DASHBOARD
  IMPORT

  @@map("appointment_source")
}

enum CallDirection {
  INBOUND
  OUTBOUND

  @@map("call_direction")
}

enum CallStatus {
  RINGING
  IN_PROGRESS
  COMPLETED
  MISSED
  ABANDONED
  FAILED

  @@map("call_status")
}

enum CallOutcome {
  BOOKED
  RESCHEDULED
  CANCELLED
  INFORMATION
  TRANSFERRED
  NONE

  @@map("call_outcome")
}

enum PrescriptionStatus {
  DRAFT
  ISSUED

  @@map("prescription_status")
}

enum FollowUpStatus {
  PENDING
  DONE
  CANCELLED

  @@map("follow_up_status")
}

enum OutboundCallStatus {
  QUEUED
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED

  @@map("outbound_call_status")
}

/// Who spoke a turn of a call transcript.
///
/// `OTHER` is not a placeholder for a bug: Sarvam does not enumerate the roles it sends on
/// the webhook's `interaction_transcript` (docs/sarvam-contract.md section 3), and a turn
/// whose speaker we cannot label is still part of what was said. Dropping it would make the
/// transcript a clinician reads differ from the conversation that happened.
enum CallTranscriptRole {
  AGENT
  CALLER
  OTHER

  @@map("call_transcript_role")
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED

  @@map("webhook_event_status")
}

model ClinicHours {
  id             String   @id @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  weekday        Weekday
  /// Clinic-local wall-clock minutes from midnight, resolved against organisations.timezone.
  /// Stored as minutes rather than a time so a DST transition cannot shift opening hours.
  opensAtMinute  Int      @map("opens_at_minute")
  closesAtMinute Int      @map("closes_at_minute")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, weekday, opensAtMinute])
  @@index([organisationId, weekday])
  @@map("clinic_hours")
}

model Doctor {
  id             String    @id @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  /// The DOCTOR-role login that owns this profile, when one exists. A doctor may be
  /// bookable without having an account.
  userId         String?   @unique @map("user_id") @db.Uuid
  fullName       String    @map("full_name")
  specialty      String?
  /// Minutes of gap enforced after each appointment for this doctor.
  bufferMinutes  Int       @default(0) @map("buffer_minutes")
  active         Boolean   @default(true)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation  Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user          User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  workingHours  DoctorWorkingHours[]
  timeOff       DoctorTimeOff[]
  services      DoctorService[]
  appointments  Appointment[]
  prescriptions Prescription[]
  followUps     FollowUp[]

  @@index([organisationId, active, deletedAt])
  @@map("doctors")
}

model DoctorWorkingHours {
  id             String   @id @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  doctorId       String   @map("doctor_id") @db.Uuid
  weekday        Weekday
  startAtMinute  Int      @map("start_at_minute")
  endAtMinute    Int      @map("end_at_minute")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  doctor       Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([organisationId, doctorId, weekday, startAtMinute])
  @@index([organisationId, doctorId, weekday])
  @@map("doctor_working_hours")
}

model DoctorTimeOff {
  id             String   @id @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  doctorId       String   @map("doctor_id") @db.Uuid
  startAt        DateTime @map("start_at") @db.Timestamptz(6)
  endAt          DateTime @map("end_at") @db.Timestamptz(6)
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  doctor       Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([organisationId, doctorId, startAt])
  @@map("doctor_time_off")
}

model Service {
  id              String    @id @db.Uuid
  organisationId  String    @map("organisation_id") @db.Uuid
  name            String
  durationMinutes Int       @map("duration_minutes")
  /// Integer minor units (paise). Never a float: money must not be approximated.
  priceMinor      Int?      @map("price_minor")
  active          Boolean   @default(true)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  doctors      DoctorService[]
  appointments Appointment[]

  @@unique([organisationId, name])
  @@index([organisationId, active, deletedAt])
  @@map("services")
}

model DoctorService {
  id             String   @id @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  doctorId       String   @map("doctor_id") @db.Uuid
  serviceId      String   @map("service_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  doctor       Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([organisationId, doctorId, serviceId])
  @@index([organisationId, serviceId])
  @@map("doctor_services")
}

model Patient {
  id             String    @id @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  /// PHI. Trigram index for search added in M1-06.
  fullName       String    @map("full_name")
  /// PHI, E.164. Indexed but NOT unique: families share numbers, and a clinic may hold
  /// two records for one number until they are merged.
  phone          String
  dateOfBirth    DateTime? @map("date_of_birth") @db.Date
  notes          String?
  /// Soft delete: appointment and prescription history must survive a patient removal.
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation  Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  appointments  Appointment[]
  calls         Call[]
  prescriptions Prescription[]
  followUps     FollowUp[]
  outboundCalls OutboundCall[]

  @@index([organisationId, phone])
  @@index([organisationId, deletedAt])
  @@map("patients")
}

model Appointment {
  id                 String            @id @db.Uuid
  organisationId     String            @map("organisation_id") @db.Uuid
  patientId          String            @map("patient_id") @db.Uuid
  doctorId           String            @map("doctor_id") @db.Uuid
  serviceId          String?           @map("service_id") @db.Uuid
  startAt            DateTime          @map("start_at") @db.Timestamptz(6)
  endAt              DateTime          @map("end_at") @db.Timestamptz(6)
  status             AppointmentStatus @default(SCHEDULED)
  source             AppointmentSource @default(DASHBOARD)
  /// Replay protection for creates the voice agent can reach (root CLAUDE.md rule 8).
  /// Unique per organisation so two clinics cannot collide on one key.
  idempotencyKey     String?           @map("idempotency_key")
  /// Set when this appointment replaces an earlier one, so a reschedule keeps its history.
  rescheduledFromId  String?           @unique @map("rescheduled_from_id") @db.Uuid
  cancelledAt        DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason String?           @map("cancellation_reason")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation    Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  patient         Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor          Doctor         @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  service         Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  rescheduledFrom Appointment?   @relation("AppointmentReschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo   Appointment?   @relation("AppointmentReschedule")
  calls           Call[]
  prescriptions   Prescription[]
  followUps       FollowUp[]

  @@unique([organisationId, idempotencyKey])
  @@index([organisationId, startAt])
  @@index([organisationId, doctorId, startAt])
  @@index([organisationId, patientId, startAt])
  @@index([organisationId, status, startAt])
  @@map("appointments")
}

model Call {
  id              String        @id @db.Uuid
  organisationId  String        @map("organisation_id") @db.Uuid
  provider        Provider      @default(SARVAM)
  /// The provider's call identifier, unique per provider.
  externalCallId  String        @map("external_call_id")
  direction       CallDirection
  status          CallStatus
  outcome         CallOutcome   @default(NONE)
  /// PHI: caller and callee numbers in E.164.
  fromE164        String        @map("from_e164")
  toE164          String        @map("to_e164")
  /// Linked when exactly one patient matches the normalised number, else left NULL.
  patientId       String?       @map("patient_id") @db.Uuid
  appointmentId   String?       @map("appointment_id") @db.Uuid
  startedAt       DateTime?     @map("started_at") @db.Timestamptz(6)
  endedAt         DateTime?     @map("ended_at") @db.Timestamptz(6)
  durationSeconds Int?          @map("duration_seconds")
  /// Integer minor units.
  costMinor       Int?          @map("cost_minor")
  /// Private S3 key, never a public URL. PHI.
  recordingKey    String?       @map("recording_key")
  transcript      String?
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation   Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  patient        Patient?             @relation(fields: [patientId], references: [id], onDelete: SetNull)
  appointment    Appointment?         @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  transcriptTurns CallTranscriptTurn[]

  @@unique([provider, externalCallId])
  @@index([organisationId, startedAt])
  @@index([organisationId, status, startedAt])
  @@index([organisationId, patientId, startedAt])
  @@map("calls")
}

/// One turn of one call's transcript. PHI, every word of it.
///
/// ITS OWN TABLE RATHER THAN TEXT ON `calls`, for two reasons. The dashboard shows a
/// transcript as a conversation, with each turn attributed, and a single text column would
/// mean inventing a line format and parsing it back out in the browser. And the mapping in
/// docs/sarvam-contract.md section 8 names a transcript table for the same reason.
///
/// `calls.transcript` remains as the plain-text rendering, which is what a search or an
/// export wants and what a reader gets if this table is empty.
model CallTranscriptTurn {
  id             String             @id @db.Uuid
  organisationId String             @map("organisation_id") @db.Uuid
  callId         String             @map("call_id") @db.Uuid
  /// Position in the conversation, from zero. Part of the unique key, so re-ingesting the
  /// same call replaces its turns instead of appending a second copy of them.
  turnIndex      Int                @map("turn_index")
  role           CallTranscriptRole
  /// PHI: the words themselves. Never logged, never in an audit payload.
  text           String
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  call         Call         @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@unique([callId, turnIndex])
  @@index([organisationId, callId, turnIndex])
  @@map("call_transcript_turns")
}

model WebhookEvent {
  id              String             @id @db.Uuid
  /// NULL until the payload is resolved to an organisation. A webhook is stored before it
  /// is understood, so this cannot be required at insert time.
  organisationId  String?            @map("organisation_id") @db.Uuid
  provider        Provider           @default(SARVAM)
  externalEventId String             @map("external_event_id")
  eventType       String             @map("event_type")
  status          WebhookEventStatus @default(RECEIVED)
  /// Raw provider payload, retained for replay. May contain PHI, so it is never logged.
  payload         Json
  /// Set when processing failed; the message, never the payload.
  lastError       String?            @map("last_error")
  attempts        Int                @default(0)
  processedAt     DateTime?          @map("processed_at") @db.Timestamptz(6)
  receivedAt      DateTime           @default(now()) @map("received_at") @db.Timestamptz(6)

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  @@unique([provider, externalEventId])
  @@index([status, receivedAt])
  @@index([organisationId, receivedAt])
  @@map("webhook_events")
}

model Prescription {
  id             String             @id @db.Uuid
  organisationId String             @map("organisation_id") @db.Uuid
  patientId      String             @map("patient_id") @db.Uuid
  doctorId       String             @map("doctor_id") @db.Uuid
  appointmentId  String?            @map("appointment_id") @db.Uuid
  status         PrescriptionStatus @default(DRAFT)
  /// PHI.
  notes          String?
  issuedAt       DateTime?          @map("issued_at") @db.Timestamptz(6)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  patient      Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor       Doctor             @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  appointment  Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  items        PrescriptionItem[]

  @@index([organisationId, patientId, createdAt])
  @@index([organisationId, doctorId, createdAt])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String   @id @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  prescriptionId String   @map("prescription_id") @db.Uuid
  /// PHI: medication, dose and instructions.
  medication     String
  dosage         String?
  frequency      String?
  durationDays   Int?     @map("duration_days")
  instructions   String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([organisationId, prescriptionId])
  @@map("prescription_items")
}

model FollowUp {
  id             String         @id @db.Uuid
  organisationId String         @map("organisation_id") @db.Uuid
  patientId      String         @map("patient_id") @db.Uuid
  doctorId       String?        @map("doctor_id") @db.Uuid
  appointmentId  String?        @map("appointment_id") @db.Uuid
  /// The STAFF user responsible. "assigned" in the permission matrix refers to this.
  assignedUserId String?        @map("assigned_user_id") @db.Uuid
  dueAt          DateTime       @map("due_at") @db.Timestamptz(6)
  status         FollowUpStatus @default(PENDING)
  /// PHI.
  notes          String?
  completedAt    DateTime?      @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor       Doctor?      @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  appointment  Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  assignedUser User?        @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([organisationId, status, dueAt])
  @@index([organisationId, assignedUserId, status])
  @@index([organisationId, patientId])
  @@map("follow_ups")
}

model OutboundCall {
  id             String             @id @db.Uuid
  organisationId String             @map("organisation_id") @db.Uuid
  patientId      String?            @map("patient_id") @db.Uuid
  /// Globally unique: a worker restart must never place a second call to a patient
  /// (apps/api/CLAUDE.md). The key is derived from what the call is FOR, not from when
  /// it was queued.
  dedupeKey      String             @unique @map("dedupe_key")
  kind           String
  status         OutboundCallStatus @default(QUEUED)
  scheduledAt    DateTime           @map("scheduled_at") @db.Timestamptz(6)
  attempts       Int                @default(0)
  lastAttemptAt  DateTime?          @map("last_attempt_at") @db.Timestamptz(6)
  lastError      String?            @map("last_error")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  patient      Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([organisationId, status, scheduledAt])
  @@index([status, scheduledAt])
  @@map("outbound_calls")
}

model ForwardingSchedule {
  id             String   @id @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  weekday        Weekday
  /// Clinic-local minutes from midnight, same reasoning as clinic_hours.
  startAtMinute  Int      @map("start_at_minute")
  endAtMinute    Int      @map("end_at_minute")
  /// Whether forwarding is ON during this window.
  forwardingOn   Boolean  @default(true) @map("forwarding_on")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  events       ForwardingEvent[]

  @@unique([organisationId, weekday, startAtMinute])
  @@index([organisationId, active, weekday])
  @@map("forwarding_schedules")
}

model ForwardingEvent {
  id             String   @id @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  scheduleId     String?  @map("schedule_id") @db.Uuid
  deviceId       String?  @map("device_id") @db.Uuid
  /// What the device reported: applied, failed, or cleared.
  outcome        String
  detail         String?
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  schedule     ForwardingSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([organisationId, occurredAt])
  @@map("forwarding_events")
}

/// A time-boxed, audited grant letting a platform role see patient fields for ONE
/// organisation. Without an active session, platform roles read patient data masked.
///
/// organisation_id is the TARGET organisation, so the row is covered by the normal
/// tenant policy: a clinic can see that it was accessed, which is the point of an
/// auditable grant.
model SupportSession {
  id             String    @id @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  /// The platform user who opened it. Has no organisation of their own.
  platformUserId String    @map("platform_user_id") @db.Uuid
  /// Stated justification. Required: an unexplained unmasking is not auditable.
  reason         String
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  platformUser User         @relation(fields: [platformUserId], references: [id], onDelete: Restrict)

  @@index([organisationId, expiresAt])
  @@index([platformUserId, expiresAt])
  @@map("support_sessions")
}

// ─── Clinic configuration (Feature 2: pilot clinic setup) ────────────────────────
//
// FIVE TABLES RATHER THAN FIFTY COLUMNS ON `organisations`. The sections are collected at
// different times, by different people, from different sources: the address comes off a
// letterhead, the booking policy from the practice manager, the agent's words from whoever
// signs off on what a machine may say to a patient. Grouping them means a write touches one
// section, an audit row names one section, and a form maps to one row.
//
// Each of the four one-to-one tables carries organisation_id and nothing else identifying,
// so it is covered by the ordinary tenant_isolation policy and the tenant client extension
// without a special case. The uniqueness of organisation_id is enforced in prisma/sql,
// alongside the policy loop that gives these tables their row-level security.
//
// EVERY FIELD IS NULLABLE. A clinic is configured over several conversations, so a
// half-collected section has to be a storable state. What has to be present before the
// agent takes a real call is `packages/shared/clinic-readiness.ts`, which is advisory and
// is the only place that says "required".

/// Who the clinic is and where it is: the answers to "what is this place called", "where
/// are you" and "how do I reach a person".
model ClinicProfile {
  id             String   @id @db.Uuid
  organisationId String   @unique @map("organisation_id") @db.Uuid
  /// The registered entity, where it differs from the name patients know.
  legalName      String?  @map("legal_name")
  /// citext so one address cannot be stored under two spellings.
  contactEmail   String?  @map("contact_email") @db.Citext
  /// E.164, normalised on the way in by the shared schema.
  contactPhone   String?  @map("contact_phone")
  website        String?
  addressLine1   String?  @map("address_line1")
  addressLine2   String?  @map("address_line2")
  city           String?
  state          String?
  postalCode     String?  @map("postal_code")
  /// ISO 3166-1 alpha-2.
  country        String?  @db.Char(2)
  /// A link the agent can send or the dashboard can show. https only.
  mapUrl         String?  @map("map_url")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@map("clinic_profiles")
}

/// The rules that decide whether a requested appointment is bookable at all.
///
/// Read by the booking logic and baked into the rendered prompt, because a policy the agent
/// does not know is a policy it will contradict.
model ClinicBookingPolicy {
  id                      String   @id @db.Uuid
  organisationId          String   @unique @map("organisation_id") @db.Uuid
  /// The grid appointments sit on, in minutes.
  slotGranularityMinutes  Int?     @map("slot_granularity_minutes")
  /// How soon before a slot a booking may still be made.
  minimumNoticeMinutes    Int?     @map("minimum_notice_minutes")
  /// How far ahead the agent may book.
  maximumAdvanceDays      Int?     @map("maximum_advance_days")
  /// How late a patient may cancel without it counting against them.
  cancellationWindowHours Int?     @map("cancellation_window_hours")
  acceptsNewPatients      Boolean? @map("accepts_new_patients")
  /// Gap after every appointment, unless a doctor's own buffer overrides it.
  defaultBufferMinutes    Int?     @map("default_buffer_minutes")
  /// More than one only for clinics that deliberately overbook.
  maxPerSlot              Int?     @map("max_per_slot")
  /// What the clinic does about a no-show, in words the agent can read out.
  noShowPolicy            String?  @map("no_show_policy")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@map("clinic_booking_policies")
}

/// How the agent behaves: what it says, in which languages, and what it must never say.
///
/// `neverPromise` is the clinical safety boundary from root CLAUDE.md rule 9 expressed as
/// clinic-specific data. The agent never diagnoses or prescribes whatever is in here; this
/// is the clinic adding its own refusals on top of that.
model ClinicAgentProfile {
  id                  String     @id @db.Uuid
  organisationId      String     @unique @map("organisation_id") @db.Uuid
  /// The first thing a caller hears.
  greeting            String?
  /// BCP-47 tags, for example en-IN. Validated for shape, not against Sarvam's set: that
  /// set is the provider's and is confirmed during the manual setup.
  languages           String[]   @default([])
  tone                AgentTone?
  /// What the agent says when there is nothing to offer.
  fullyBookedResponse String?    @map("fully_booked_response")
  /// When to hand the call to a human, in the clinic's own words.
  escalationRules     String?    @map("escalation_rules")
  /// Discrete items, because each becomes one line of the rendered prompt.
  neverPromise        String[]   @default([]) @map("never_promise")
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@map("clinic_agent_profiles")
}

/// Recording and consent, which is a legal position rather than a preference.
///
/// Stored separately from the agent's words because it is the one section a lawyer rather
/// than a practice manager answers, and because `consentConfirmedAt` is evidence: it
/// records that a named person at the clinic accepted the arrangement.
model ClinicTelephony {
  id                     String                @id @db.Uuid
  organisationId         String                @unique @map("organisation_id") @db.Uuid
  recordingConsentMode   RecordingConsentMode? @map("recording_consent_mode")
  /// The exact words played to the caller, stored so they are auditable, not guessed.
  consentAnnouncement    String?               @map("consent_announcement")
  /// When somebody at the clinic confirmed the arrangement is theirs.
  consentConfirmedAt     DateTime?             @map("consent_confirmed_at") @db.Timestamptz(6)
  /// A member of clinic staff, never a patient, so the name may be stored.
  consentConfirmedByName String?               @map("consent_confirmed_by_name")
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@map("clinic_telephony")
}

/// Answers the clinic wants given verbatim, in the order the clinic gave them.
///
/// Its own table rather than an array, because each entry is edited, reordered and switched
/// off individually, and because the voice work will later want to match a spoken question
/// against these rows.
model ClinicFaq {
  id             String   @id @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  question       String
  answer         String
  /// The clinic's own ordering, which is also the order the prompt renders them in.
  sortOrder      Int      @map("sort_order")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, sortOrder])
  @@index([organisationId, active, sortOrder])
  @@map("clinic_faqs")
}
