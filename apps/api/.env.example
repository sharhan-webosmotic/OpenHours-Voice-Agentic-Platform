# apps/api environment. Copy to apps/api/.env for local development.
# LOCAL DEVELOPMENT PLACEHOLDERS ONLY - never commit real secrets.
# In staging and production every value comes from AWS Secrets Manager.

# development | test | production
NODE_ENV=development
PORT=3000

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=debug

# Must match the credentials and port in the root .env used by docker compose.
DATABASE_URL=postgresql://clinicai:local_dev_only_change_me@localhost:5432/clinicai

# How long in-flight requests get to finish on SIGTERM before the process exits.
SHUTDOWN_TIMEOUT_MS=10000

# ─── HTTP hardening ──────────────────────────────────────────────────────────
# Comma-separated exact origins allowed to call the API from a browser. Empty means
# no cross-origin browser access. "*" is rejected at boot while credentials are on.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
CORS_ALLOW_CREDENTIALS=true

# "false", or the NUMBER of reverse-proxy hops to trust. Never "true": that trusts the
# whole X-Forwarded-For chain, letting any client spoof its address and evade the
# IP-keyed rate limit. Behind one ALB in AWS this is 1.
TRUST_PROXY=false

# Maximum JSON request body.
BODY_LIMIT=100kb

# Defaults for createRateLimiter(). Auth and webhook routes override these.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ─── Authentication ──────────────────────────────────────────────────────────
# At least 32 bytes. Generate with: openssl rand -base64 48
# In staging and production this comes from AWS Secrets Manager and is rotatable.
JWT_SECRET=local_dev_only_replace_me_with_at_least_32_bytes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
LOGIN_MAX_FAILURES=5
LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX_PER_IP=10
AUTH_RATE_LIMIT_MAX_PER_EMAIL=5
PAIRING_CODE_TTL_MINUTES=10
# Set false ONLY for plain-HTTP local development.
COOKIE_SECURE=false
