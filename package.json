{
  "name": "openhours-platform",
  "version": "0.1.0",
  "private": true,
  "description": "OpenHours Voice Agentic Platform - multi-tenant clinic SaaS with an AI voice receptionist.",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.15.0",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "openapi": "node scripts/openapi.mjs",
    "openapi:check": "node scripts/openapi-check.mjs",
    "db:migrate": "pnpm --filter @openhours/api db:migrate",
    "db:migrate:create": "pnpm --filter @openhours/api db:migrate:create",
    "db:sql": "pnpm --filter @openhours/api db:sql",
    "db:check-policies": "pnpm --filter @openhours/api db:check-policies",
    "db:seed": "pnpm --filter @openhours/api db:seed",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm test && pnpm openapi:check",
    "prepare": "husky",
    "generate": "turbo run generate"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js,json,md,yml,yaml,css}": [
      "prettier --write"
    ],
    "*.{ts,tsx,mjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ]
  }
}
